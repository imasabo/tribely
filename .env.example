# Firebase Console → Authentication → Google → Web SDK configuration (Web client ID)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Dev only (ignored in production builds). Restart Metro after changing.
# false = preview sign-in + local username checks (default in __DEV__)
# true  = real Google Sign-In + Firestore username availability/claims
EXPO_PUBLIC_USE_REAL_AUTH=false
